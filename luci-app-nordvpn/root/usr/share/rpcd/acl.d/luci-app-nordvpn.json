{
	"luci-app-nordvpn": {
		"description": "Grant access to NordVPN status, configuration and control",
		"read": {
			"ubus": {
				"nordvpn": [ "status", "instances", "locations", "servers", "refresh_status" ]
			},
			"uci": [ "nordvpn" ]
		},
		"write": {
			"ubus": {
				"nordvpn": [ "set_credentials", "apply", "refresh_locations", "rotate_now", "create_instance", "delete_instance" ]
			},
			"uci": [ "nordvpn" ]
		}
	}
}

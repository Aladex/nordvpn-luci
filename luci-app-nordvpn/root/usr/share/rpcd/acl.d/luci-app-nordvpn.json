{
	"luci-app-nordvpn": {
		"description": "Grant access to NordVPN status, configuration and control",
		"read": {
			"ubus": {
				"nordvpn": [ "status", "instances", "locations", "servers", "refresh_status", "apply_status", "external_ip" ]
			},
			"uci": [ "nordvpn" ]
		},
		"write": {
			"ubus": {
				"nordvpn": [ "set_credentials", "clear_credentials", "apply", "apply_start", "disconnect", "refresh_locations", "rotate_now", "create_instance", "delete_instance" ]
			},
			"uci": [ "nordvpn" ]
		}
	}
}

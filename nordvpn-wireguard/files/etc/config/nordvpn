# One section per VPN instance. 'main' is the default instance; additional
# `config instance '<name>'` sections run their own tunnel on their own
# interface with their own credentials (NordVPN reportedly locks a key that is
# reused elsewhere, so issue a separate access token per instance). The
# server-list cache options (cache_dir, cache_refresh_interval) are shared and
# read from this section.
config instance 'main'
	# Master switch. A fresh install ships disabled so no tunnel starts and
	# no routing changes happen before the user configures credentials.
	option enabled '0'
	# Managed WireGuard interface (UCI section name in /etc/config/network).
	option interface 'nordvpn'
	# Optional custom routing table (ip4table/ip6table). Empty = main table.
	option routing_table ''
	# 'single', 'multihop' (Double VPN) or 'onion' (Onion Over VPN via Tor).
	option hop_mode 'single'
	# Two-letter country code and 'cc-cityslug' city code for server selection.
	option country_code ''
	option city_code ''
	# When set, pin this specific gateway hostname and disable rotation.
	option fixed_server ''
	# Automatic rotation.
	option rotation_enabled '0'
	option rotation_mode 'interval'
	option rotation_interval '360'
	option rotation_time '04:30'
	# Seconds to wait for a WireGuard handshake when verifying a server, and
	# how many candidate servers a rotation may try before giving up.
	option verify_timeout '8'
	option max_retries '10'
	# Automatic traffic routing: create a firewall zone and route all LAN
	# traffic through the tunnel. Enabled for fresh installs; ignored (never
	# touches anything) when a custom routing table or own routes are detected.
	option auto_routing '1'
	# Only meaningful with auto_routing: block LAN->WAN when the VPN is down
	# (kill switch) and block direct IPv6 so it cannot bypass the tunnel.
	option killswitch '0'
	option block_ipv6 '1'
	# Push NordVPN's resolvers (103.86.96.100/99.100) while the tunnel is up.
	option use_vpn_dns '0'
	# Server-list cache directory (empty = /tmp) and background refresh period.
	option cache_dir ''
	option cache_refresh_interval '21600'
	# Stamped by the migration/uci-defaults script; gates one-shot migrations.
	# option config_version '1'

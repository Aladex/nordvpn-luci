#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: 0BSD
# Consolidated NordVPN service: one procd-supervised ucode daemon that refreshes
# the server-list cache and runs scheduled rotation. The daemon reads
# /etc/config/nordvpn and re-reads it on every tick; the reload trigger restarts
# it when the config changes.

START=99
USE_PROCD=1

EXTRA_COMMANDS="version"
EXTRA_HELP="	version         Show the installed nordvpn-wireguard version"

version() {
	ucode -e 'print(require("nordvpn.common").VERSION, "\n");' 2>/dev/null
}

start_service() {
	# One-time cleanup of cron entries left by very old cron-based versions.
	# Guarded so it never runs against the build host image.
	if [ -z "$IPKG_INSTROOT" ] && command -v crontab >/dev/null 2>&1; then
		crontab -l 2>/dev/null \
			| grep -v '/usr/bin/nordvpn-rotate' \
			| grep -v '/usr/bin/nordvpn-cache-update' \
			| crontab - 2>/dev/null
	fi

	procd_open_instance nordvpn
	procd_set_param command /usr/bin/nordvpn-service
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "nordvpn"
}

reload_service() {
	stop
	start
}

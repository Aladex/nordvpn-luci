#!/usr/bin/lua
-- One-shot NordVPN server-list cache updater.
-- Invoked by the nordvpn-cache procd service; also safe to run manually.
-- Any command-line arguments are ignored (the legacy cron job used to
-- pass an interface name, which the cache logic does not need).

local ok, cache = pcall(require, "luci.nordvpn.cache")
if not ok then
	io.stderr:write("nordvpn-cache-update: failed to load luci.nordvpn.cache: " .. tostring(cache) .. "\n")
	os.exit(1)
end

local data, err = cache.fetch_and_build_cache()
if not data then
	io.stderr:write("nordvpn-cache-update: cache update failed: " .. tostring(err) .. "\n")
	os.exit(1)
end

local cache_file = cache.get_cache_file_path()
local stats = data.stats or {}
print(string.format(
	"nordvpn-cache-update: cached %d servers in %d cities across %d countries -> %s",
	stats.gateways or 0,
	stats.cities or 0,
	stats.countries or 0,
	cache_file
))
os.exit(0)
